includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - config
        - database
    tmpDir: build/phpstan
    excludePaths:
        - database/factories/ModelFactory.php
    ignoreErrors:
        # Host-app and optional dependencies that are not installed in the package.
        -
            identifier: class.notFound
            paths:
                - src/Commands/LeChatCommand.php
                - src/Notifications/NewMessage.php
